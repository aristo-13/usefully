# Copy to .env.local and fill in what you have. Values that are empty or still
# start with "your-" count as not set, so a placeholder never breaks the site:
# the feature behind it just stays off until you add the real value.
# NEXT_PUBLIC_ values are compiled into the build: rebuild after changing them.

# --- Required ------------------------------------------------------------------

# Supabase → Project Settings → API Keys: the project URL and the publishable
# key (the legacy anon key also works). Never put a secret/service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Public address of the site. Used for canonical URLs, the sitemap, robots.txt
# and social previews. Set it to your real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Branding (these are the defaults) -----------------------------------------

NEXT_PUBLIC_SITE_NAME=Usefully
NEXT_PUBLIC_SITE_DESCRIPTION=Practical articles, step-by-step tutorials, reviewed resources and useful downloads.

# --- AI writer (server only) ----------------------------------------------------
# Turns on the "Write with AI" buttons in the post editor. See README → AI writer.
# With both keys set, Claude is used.

# Free: Gemini API key from aistudio.google.com → Get API key (no card needed).
# Free limits are per model and per day, shared by every site using the key.
GEMINI_API_KEY=your-gemini-api-key
# Optional: other models when Google retires the defaults. The first writes
# bodies, the second titles, summaries, SEO fields, tags and categories.
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_LIGHT_MODEL=gemini-3.5-flash-lite

# Paid, stronger, searches the web: Claude API key from console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- Google AdSense (public) ----------------------------------------------------

# Publisher ID from AdSense → Account → Account information, e.g. ca-pub-1234567890123456.
# Adds the AdSense code to public pages, serves /ads.txt and opens the CSP for ads.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=your-adsense-publisher-id
# Optional: ID of an "In-article" ad unit (Ads → By ad unit), e.g. 1234567890.
# Without it, only Auto ads (switched on in AdSense) are shown.
NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=your-in-article-ad-slot-id

# Optional: shown on the privacy page as the address for privacy questions.
NEXT_PUBLIC_CONTACT_EMAIL=your-contact-email

# --- Trends and SEO (server only, never give these a NEXT_PUBLIC_ name) ---------

# Free YouTube Data API v3 key: popular videos on the Trends page.
YOUTUBE_API_KEY=your-youtube-api-key
# Bearer token of a paid X API plan that includes trends.
X_BEARER_TOKEN=your-x-bearer-token
# Search Console: the service account's JSON key (or the same JSON base64-encoded)
# and your property, e.g. sc-domain:usefully.live or https://usefully.live/
GOOGLE_SERVICE_ACCOUNT_KEY=your-service-account-json-key
SEARCH_CONSOLE_PROPERTY=your-search-console-property
# 8 to 128 letters, digits or dashes, e.g. node -e "console.log(crypto.randomUUID())".
# Public by design: served at /indexnow.txt.
INDEXNOW_KEY=your-indexnow-key

# --- Self-hosting with several instances only ------------------------------------

# Same value on every instance, e.g. node -e "console.log(crypto.randomBytes(32).toString('base64'))"
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
